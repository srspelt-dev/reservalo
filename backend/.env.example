# Backend environment configuration
ENVIRONMENT=development
DEBUG=true

# Database (matches docker-compose service name "db")
DATABASE_URL=postgresql+psycopg2://reservalo:reservalo@db:5432/reservalo

# JWT — generate with: openssl rand -hex 32
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# Public site base URL (para los enlaces de gestión en los emails)
PUBLIC_BASE_URL=http://localhost:3000

# Email / SMTP. Si SMTP_HOST queda vacío, los emails se loguean por consola
# (la confirmación al cliente y el aviso al dueño funcionan igual en desarrollo).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Reservalo <no-reply@reservalo.app>
SMTP_TLS=true

# Recordatorios automáticos (email "X horas antes" del turno)
REMINDER_ENABLED=true
REMINDER_HOURS_BEFORE=24
REMINDER_INTERVAL_MINUTES=15
